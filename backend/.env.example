PORT=3000
NODE_ENV=production
# Use a long random value. This protects the web app and API with HTTP Basic Auth.
APP_USERNAME=homeai
APP_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
GEMINI_API_KEY=PASTE_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
# Required for song/video search results. Enable YouTube Data API v3 in Google Cloud.
YOUTUBE_API_KEY=PASTE_YOUTUBE_DATA_API_KEY_HERE
# MQTT broker, e.g. HiveMQ Cloud TLS endpoint (do not include mqtts:// in host)
MQTT_URL=mqtts://YOUR_CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_TOPIC_PREFIX=homeai/your-random-device-id
